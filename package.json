{
  "name": "imagegenerator",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
  "start": "node server.js",
    "dev:server": "node --watch server.js",
    "dev:client": "npm run dev --prefix app",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:wait-electron": "wait-on http://localhost:5173 && npm run dev:electron",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:wait-electron\"",
    "predist": "npm run build && electron-rebuild -f -w sharp",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.character.studio",
    "productName": "Character Studio",
    "npmRebuild": true,
    "electronVersion": "latest",
    "files": [
      "main.js",
      "server.js",
      "server/**/*",
      "app/dist/**/*",
      "node_modules/**/*",
      "!node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "server/data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.3",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.4"
  }
}
