{
  "name": "imagegenerator",
  "version": "1.4.0",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "setup:python": "node setup-python.js",
    "setup:comfy": "node setup-comfyui.js",
    "dev:preflight": "node preflight.js",
    "dev:server": "node --watch server.js",
    "dev:client": "npm run dev --prefix app",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:wait-electron": "wait-on http://localhost:5173 && npm run dev:electron",
    "dev": "npm run dev:preflight && concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:wait-electron\"",
    "predist": "cd app && npm run build && cd .. && electron-rebuild -f -w sharp",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "build": "npm run predist && npm run dist"
  },
  "build": {
    "appId": "com.character.studio",
    "productName": "Character Studio",
    "npmRebuild": true,
    "electronVersion": "41.0.3",
    "directories": {
      "app": ".",
      "output": "dist"
    },
    "nsis": {
      "include": "build/installer.nsh"
    },
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "server.js",
      "comfyui.js",
      "expo-tunnel.js",
      "server/**/*",
      "app/dist/**/*",
      "!server/data",
      "!server/data/**",
      "node_modules/**/*",
      "!node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "app-mobile",
        "to": "app-mobile",
        "filter": ["**/*", "!node_modules/**", "!node_modules", "!.expo/**", "!.expo"]
      },
      {
        "from": "shared",
        "to": "shared",
        "filter": ["**/*"]
      },
      {
        "from": "react-diffuse",
        "to": "react-diffuse",
        "filter": ["**/*", "!node_modules/**", "!node_modules"]
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon2.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon2.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon2.png",
      "target": [
        "AppImage"
      ]
    }
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@expo/ngrok": "^4.1.0",
    "@expo/ngrok-bin-win32-x64": "^2.3.40",
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.3",
    "expo-media-library": "^55.0.14",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.4"
  }
}
