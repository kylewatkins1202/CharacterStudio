# Required
WAVESPEED_API_KEY=your_wavespeed_api_key_here

# Optional
PORT=4989
JSON_BODY_LIMIT="100mb"

# LLM defaults (optional but recommended)
LLM_MODEL="google/gemini-2.5-flash"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1400

# Vision (tag locking)
VISION_MODEL="google/gemini-2.5-flash"
VISION_ENABLED=true
VISION_FORCE=false